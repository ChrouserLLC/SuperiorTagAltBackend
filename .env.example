# ---------------------------------------------------------------------------
# Superior Tag Alt Backend - environment
# Copy to .env (or paste into Vercel > Settings > Environment Variables).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Shared secret for every client-facing endpoint (/api/report, /api/tracker,
# /api/redeem, /api/redeem-codes, /api/online-count, /api/tracker/refresh).
# The Unity client sends this in the JSON body as "secret".
#
# CAVEAT: this ships inside the APK and can be extracted. It stops casual
# abuse; it is not real authentication. Real authority lives in the
# CloudScript allowlists (INSTABAN_REPORTERS, TrackerAdmins).
API_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING

# PlayFab server credentials (PlayFab Dashboard > Settings > API Access).
# Required for: tracker role lookup, /api/tracker/tracked, /api/tracker/refresh,
# and for triggering the insta-ban CloudScript.
PLAYFAB_TITLE_ID=ABC123
PLAYFAB_SECRET_KEY=REPLACE_ME

# Discord webhooks. Leave blank to disable that channel (endpoints still
# return success:true, with webhook_sent:false).
TRACKER_WEBHOOK_URL=
TRACKER_VIP_WEBHOOK_URL=
REPORT_WEBHOOK_URL=
REDEEM_WEBHOOK_URL=

# Anti-spam cooldowns, in seconds.
TRACKER_COOLDOWN_SECONDS=10
REPORT_COOLDOWN_SECONDS=15
REDEEM_COOLDOWN_SECONDS=5

# PlayFab Title Data key holding the redeem code table. Managed by
# /api/redeem-codes; normally leave as-is. See README for the format.
REDEEM_CODES_KEY=RedeemCodes

# Optional seed code table, used only until TitleData has a RedeemCodes value.
# Lets a fresh deploy work before anyone has created a code.
# Example: {"BETA": {"reward_id": "LBAAA", "reward_label": "Beta Tester"}}
REDEEM_CODES_JSON=

# PlayFab Title Data key holding the tracked-player role lists.
# Managed by cloudscript/SuperiorTagAlt.js - normally leave as-is.
TRACKED_PLAYERS_KEY=TrackedPlayers

# Optional JSON object of per-role Discord emoji, e.g.
# {"moderator": ["<:mod:123>"], "content_creator": ["<a:cc:456>"]}
# Rotates hourly when a list has more than one entry.
TRACKER_ROLE_EMOJIS={}

# How long a player stays in the dashboard's per-player list without a fresh
# tracker event. The client only posts on join/leave, so keep this comfortably
# longer than a typical session. Default 900 (15 minutes).
ONLINE_PLAYER_TTL_SECONDS=900
